LANG = "en"


def tr(key, *args, lang=None):
    """The text for `key` in the configured language (English when a key is missing)."""
    text = STRINGS.get(lang or LANG, STRINGS["en"]).get(key) or STRINGS["en"][key]
    return text % args if args else text


# --- configuration ----------------------------------------------------------------------

DEFAULT_REMOTE_HERDR = 'PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$PATH" herdr'


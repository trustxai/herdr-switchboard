#!/usr/bin/env python3
"""switchboard: every herdr agent, on every saved machine, in one popup ordered by priority.

    switchboard                 the popup: fzf over the rows (what the plugin pane runs)
    switchboard --demo          the same interface over bundled fixtures: no herdr, no ssh
    switchboard --rows          print the rows without fzf
    switchboard --preview ID    the preview of one row (fzf calls this)
    switchboard --version

One row per agent, in the order of herdr's native agent panel with
agent_panel_sort = "priority": blocked, done, working, idle, unknown. Inside a status the
agent whose change was seen last goes first, whatever machine it is on. Plain terminals
go last. The preview at the bottom shows the end of the pane (`herdr pane read`).

What the native Goto does not do and this does: it orders by priority instead of grouping
by workspace, and it lists the agents of every saved machine (`herdr machine list`) next
to the local ones. While open it refreshes itself.

Python 3.9 and the standard library only: macOS ships /usr/bin/python3 3.9.
"""
import atexit
import base64
import copy as copymod
import glob
import json
import math
import os
import re
import select
import shlex
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata

try:
    import tomllib
except ImportError:  # Python < 3.11: the built-in parser below reads the config
    tomllib = None

VERSION = "0.1.0"
PLUGIN_ID = "trustxai.switchboard"
APP_DIR = "herdr-switchboard"   # config and state directory name outside herdr
MIN_PYTHON = (3, 9)
MIN_FZF = (0, 71)               # --id-nth, which keeps the cursor on the same agent on reload

# A plugin pane inherits the PATH of the herdr server, which may have started without
# Homebrew's directories. fzf and herdr usually live there. They go at the end, so they
# only fill gaps and never shadow what the user put first.
for _d in ("/opt/homebrew/bin", "/home/linuxbrew/.linuxbrew/bin", "/usr/local/bin",
           os.path.expanduser("~/.local/bin")):
    if os.path.isdir(_d) and _d not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = os.environ.get("PATH", "") + os.pathsep + _d


def find_herdr(env=None):
    """The herdr binary: the one herdr injects into plugin commands, else the one on PATH."""
    env = os.environ if env is None else env
    return env.get("HERDR_BIN_PATH") or shutil.which("herdr", path=env.get("PATH")) or "herdr"


HERDR = find_herdr()
LOCAL = ""  # machine id of the rows of this machine

# Escape sequences (CSI, OSC, DCS and the like) and control characters (C0, DEL, C1).
ESCAPE_SEQ = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?"
                        r"|\x1b[PX^_][^\x1b]*(?:\x1b\\)?|\x1b.?")
CONTROL_CHARS = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def clean(text):
    """One line of plain text, without escape sequences or control characters. A number
    becomes its digits; any other non-string (a list where a label should be) becomes ""."""
    if isinstance(text, (int, float)) and not isinstance(text, bool):
        text = str(text)
    elif not isinstance(text, str):
        return ""
    return CONTROL_CHARS.sub("", ESCAPE_SEQ.sub("", text))


# For pane contents shown in the preview: colours (SGR) and line breaks stay, every other
# escape (clipboard writes, title changes, screen clears) and control character goes.
SCREEN_TOKENS = re.compile(r"(\x1b\[[0-9;:]*m)|" + ESCAPE_SEQ.pattern + r"|[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def clean_screen(text):
    return SCREEN_TOKENS.sub(lambda m: m.group(1) or "", text)


# What a herdr id looks like ("w1:p3", a machine id). Ids go into herdr's argv and into
# the row id, so one that could pass for an option or break a row is refused.
SAFE_ID = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_:.@+=-]{0,127}")


def safe_id(value):
    # fullmatch, not match: "$" also matches before a trailing newline.
    return isinstance(value, str) and SAFE_ID.fullmatch(value) is not None


def _int(value, default=0):
    return value if isinstance(value, int) and not isinstance(value, bool) else default

